# ==============================
# Обязательные (из tg-core)
# ==============================
BOT_TOKEN=your_bot_token_here
ADMIN_IDS=123456789
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/vpn_bot

# ==============================
# Опциональные (из tg-core)
# ==============================
DEBUG=false
RATE_LIMIT=30
RATE_LIMIT_WINDOW=60
TIMEZONE=Europe/Moscow

# ==============================
# VPN провайдер
# ==============================
VPN_PROVIDER=xui                        # xui | outline | amnezia

# ==============================
# 3x-ui панель
# ==============================
XUI_PANEL_URL=https://your-panel.com:54321
XUI_USERNAME=admin
XUI_PASSWORD=your_password
XUI_EXTERNAL_IP=1.2.3.4
XUI_SERVER_PORT=443
XUI_INBOUND_ID=1

# ==============================
# Параметры подписки
# ==============================
EXPIRY_DAYS=30
DATA_LIMIT_GB=0                         # 0 = безлимит

# ==============================
# Триальный период
# ==============================
TRIAL_ENABLED=true
TRIAL_DAYS=3

# ==============================
# Telegram Stars оплата
# ==============================
PAYMENT_ENABLED=false
PAYMENT_AMOUNT=50
PAYMENT_DESCRIPTION=VPN подписка на 30 дней

# ==============================
# Pre-action шаги
# Настраивается в config.py через PRE_ACTION_STEPS
# ==============================

# ==============================
# Напоминания
# ==============================
NOTIFY_DAYS_BEFORE=[3,1]

# ==============================
# GitHub — для установки tg-core
# ==============================
GITHUB_TOKEN=your_github_token_here
