# ==============================
# Обязательные (из tgbotcore)
# ==============================
BOT_TOKEN=your_bot_token_here
ADMIN_IDS=123456789
DATABASE_URL=postgresql+asyncpg://user:password@postgres:5432/tg_vpn_postgres

# ==============================
# База данных PostgreSQL
# ==============================
POSTGRES_DB=tg_vpn_postgres
POSTGRES_USER=tg_vpn_postgres
POSTGRES_PASSWORD=tg_vpn_postgres

# ==============================
# Опциональные (из tgbotcore)
# ==============================
DEBUG=false
RATE_LIMIT=30
RATE_LIMIT_WINDOW=60
TIMEZONE=Europe/Moscow
REFERRAL_BONUS=10

# ==============================
# VPN провайдер
# ==============================
VPN_PROVIDER=amnezia                    # xui | amnezia

# ------------------------------------------------------------------
# XUI (3x-ui)
# ------------------------------------------------------------------
XUI_PANEL_URL=https://your-panel.com:54321
XUI_USERNAME=admin
XUI_PASSWORD=your_password
XUI_EXTERNAL_IP=1.2.3.4
XUI_SERVER_PORT=443
XUI_INBOUND_ID=1
XUI_SERVER_NAME=yandex.ru

# ------------------------------------------------------------------
# AmneziaWG (amneziawg-web-ui)
# ------------------------------------------------------------------
AWG_API_URL=http://your-server:8080
AWG_SERVER_ID=your_server_id
AWG_USERNAME=admin
AWG_PASSWORD=your_password

# ==============================
# Параметры подписки
# ==============================
EXPIRY_DAYS=30
DATA_LIMIT_GB=0                         # 0 = безлимит

# ==============================
# Триальный период
# ==============================
TRIAL_ENABLED=true
TRIAL_DAYS=3

# ==============================
# Pre-action шаги
# Настраивается в config.py через PRE_ACTION_STEPS
# Доступные типы: ad | channel | stars_payment
#
# Пример конфига в config.py:
#PRE_ACTION_STEPS = [
#    {
#        "type": "ad",
#        "enabled": False,
#        "text": "Текст рекламы",
#        "button_text": "▶️ Продолжить",  # кнопка (приоритет над duration)
#        "duration": 5,                    # пауза в секундах
#    },
#    {
#        "type": "channel",
#        "enabled": False,
#        "channel": "@your_channel",
#        "message": "Подпишитесь на наш канал",
#        "button_check": "✅ Проверить подписку",
#        "button_cancel": "❌ Отмена",
#    },
#    {
#        "type": "stars_payment",
#        "enabled": False,
#        "amount": 50,
#        "title": "VPN подписка",
#        "description": "VPN на 30 дней",
#    },
#]
# ==============================

# ==============================
# Напоминания об истечении подписки
# ==============================
NOTIFY_DAYS_BEFORE=[3,1]